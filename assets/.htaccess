# Configuración del servidor para meetbecome.com (Hostinger, LiteSpeed/Apache).
#
# Este archivo vive en assets/ porque Vite copia esa carpeta tal cual a dist/,
# que es lo que se sube a public_html. Si se pusiera en la raíz del repositorio
# no llegaría nunca al servidor.
#
# Lo que hay aquí, y por qué:
#
#   1. El sitio es una SPA: el servidor solo tiene index.html. Sin la regla de
#      reescritura, entrar directo a /es/servicios o recargar esa página da un
#      404 del servidor, porque ese archivo no existe en disco. Es el fallo
#      número uno al publicar una SPA y no se ve en local, donde el servidor de
#      desarrollo ya hace esto por su cuenta.
#   2. Un solo dominio canónico. Sin esto el sitio existe en cuatro direcciones
#      —con y sin https, con y sin www— y Google las trata como cuatro sitios
#      distintos compitiendo entre ellos.
#   3. Caducidad de caché distinta según el archivo. Los del bundle llevan un
#      hash en el nombre, así que pueden cachearse un año sin riesgo: si cambian,
#      cambia el nombre. index.html no lleva hash y no puede cachearse nunca, o
#      los visitantes se quedan clavados en la versión vieja.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Dominio canónico y HTTPS
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sin cifrar → cifrado
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → sin www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ───────────────────────────────────────────────────────────────────────────
  # Direcciones que cambiaron de nombre
  # ───────────────────────────────────────────────────────────────────────────
  # Los dos servicios pasaron a llamarse BECOME DISCOVER™ y BECOME EMBED™, y su
  # dirección con ellos. Un 301 —y no la redirección del enrutador de React—
  # porque es lo único que traslada el posicionamiento de la URL vieja a la
  # nueva; con una redirección de JavaScript, para un buscador son dos páginas
  # distintas y la vieja acaba en 404 el día que se retire.
  RedirectMatch 301 ^/es/servicios/transformation-discovery/?$ /es/servicios/become-discover
  RedirectMatch 301 ^/es/servicios/build-and-embed/?$          /es/servicios/become-embed
  RedirectMatch 301 ^/en/services/transformation-discovery/?$  /en/services/become-discover
  RedirectMatch 301 ^/en/services/build-and-embed/?$           /en/services/become-embed

  # El apartado pasó de llamarse «casos de uso» a «soluciones», y cuatro de las
  # seis cambiaron de dirección. Dos ya no tienen equivalente: «por dónde
  # empezar» desapareció como solución propia —es lo que hace BECOME DISCOVER™
  # entero— y «demostrar valor en 90 días» se convirtió en «medir y gobernar el
  # valor», que es la necesidad de fondo. Ambas van al índice: es preferible a
  # un 404, y a inventar una correspondencia que no existe.
  RedirectMatch 301 ^/es/casos-de-uso/pilotos-que-no-escalan/?$      /es/soluciones/escalar-ia
  RedirectMatch 301 ^/es/casos-de-uso/redisenar-workflow-critico/?$  /es/soluciones/redisenar-procesos-criticos
  RedirectMatch 301 ^/es/casos-de-uso/construir-agent-o-copilot/?$   /es/soluciones/agentes-de-ia-con-control
  RedirectMatch 301 ^/es/casos-de-uso/experiencia-ai-native/?$       /es/soluciones/productos-y-servicios-con-ia
  RedirectMatch 301 ^/es/casos-de-uso/demostrar-valor-en-90-dias/?$  /es/soluciones/medir-y-gobernar-valor
  RedirectMatch 301 ^/es/casos-de-uso(/.*)?$                         /es/soluciones

  RedirectMatch 301 ^/en/use-cases/pilotos-que-no-escalan/?$         /en/solutions/scale-ai-beyond-pilots
  RedirectMatch 301 ^/en/use-cases/redisenar-workflow-critico/?$     /en/solutions/redesign-critical-workflows
  RedirectMatch 301 ^/en/use-cases/construir-agent-o-copilot/?$      /en/solutions/deploy-governed-ai-agents
  RedirectMatch 301 ^/en/use-cases/experiencia-ai-native/?$          /en/solutions/build-ai-enabled-products
  RedirectMatch 301 ^/en/use-cases/demostrar-valor-en-90-dias/?$     /en/solutions/measure-and-govern-ai-value
  RedirectMatch 301 ^/en/use-cases(/.*)?$                            /en/solutions

  # La raíz no tiene página propia: el sitio empieza en /es. La redirección la
  # hace el servidor y no React para que los buscadores vean un 301 de verdad
  # en vez de una página vacía que se redirige sola con JavaScript.
  RewriteRule ^$ /es [L,R=301]

  # ───────────────────────────────────────────────────────────────────────────
  # 2. La cabecera propia de cada ruta
  # ───────────────────────────────────────────────────────────────────────────
  # Al compilar se genera un _pages/<ruta>.html por página, idéntico al
  # index.html salvo en la cabecera: su título, su descripción, su canonical,
  # sus hreflang y sus datos estructurados. Sin esto, las 44 URLs del sitio
  # comparten los metadatos de la home y en los resultados de búsqueda todas
  # dicen llamarse igual.
  #
  # La regla es aditiva: solo actúa si el archivo existe. Si faltara, la
  # petición sigue cayendo en la regla de la SPA de abajo y el sitio funciona
  # exactamente igual que antes — peor posicionado, pero nunca roto.
  RewriteCond %{DOCUMENT_ROOT}/_pages%{REQUEST_URI}.html -f
  RewriteRule ^(.+)$ /_pages/$1.html [L]

  # ───────────────────────────────────────────────────────────────────────────
  # 3. Reescritura de la SPA
  # ───────────────────────────────────────────────────────────────────────────
  # Si el archivo o la carpeta existen de verdad, se sirven tal cual. Cualquier
  # otra cosa la resuelve el enrutador de React dentro de index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# 3. Caché
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Sin hash en el nombre: caducidades cortas, porque cambiar el archivo NO
  # cambia su dirección y una caché larga serviría la versión vieja durante
  # días. Es exactamente lo que pasó con el logotipo.
  <FilesMatch "\.(js|css)$">
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2|woff)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>

  # El HTML nunca se cachea: es lo único que sabe qué bundle toca cargar, y eso
  # cambia en cada despliegue. Vale para index.html y para las 64 cabeceras por
  # ruta de _pages/. Sin esta regla el navegador aplica su propia heurística y
  # puede quedarse con un HTML viejo que pide archivos que ya no existen.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2|woff)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Y por encima de todo lo anterior: lo que vive en /assets/ lo compila Vite
  # y lleva un hash del contenido en el nombre —index-BgoHAaAX.js,
  # inter-variable-latin-Dx4kXJAl.woff2—. Si el archivo cambia, cambia su
  # dirección, así que un año sin revalidar no puede servir nada viejo.
  #
  # Va por ubicación y no por extensión porque el hash no se distingue de un
  # guion normal: se probó un patrón de «guion más ocho caracteres» contra el
  # dist/ real y marcaba como inmutables 21 archivos que no llevan hash
  # —machine-learning-white.webp, 01-neural-network.webp—, que es exactamente
  # el error que dejó el logotipo viejo servido durante días.
  #
  # Segundo intento. El primero fue un .htaccess propio DENTRO de assets/ y el
  # servidor respondió 403 a toda la carpeta: el sitio servía su HTML y no su
  # código. Esta versión vive aquí, en el archivo de la raíz que lleva meses
  # funcionando, y va envuelta en su IfModule: si mod_setenvif no estuviera
  # cargado, esto se ignora en vez de tumbar el sitio con un error de sintaxis.
  # Y si aun así algo saliera mal, el despliegue lo detecta: comprueba que el
  # bundle publicado responde 200 y con tipo JavaScript, y falla en rojo si no.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" LLEVA_HASH
    Header set Cache-Control "public, max-age=31536000, immutable" env=LLEVA_HASH
  </IfModule>
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# 4. Compresión
# ─────────────────────────────────────────────────────────────────────────────
# LiteSpeed suele traerla activada; esto la garantiza si no lo está. El bundle
# principal pasa de 260 KB a 84 KB comprimido.
<IfModule mod_deflate.c>
  # text/javascript va primero a propósito. Es el tipo con el que los
  # servidores modernos sirven un .js —application/javascript quedó obsoleto—,
  # y si no está en esta lista el bundle viaja SIN COMPRIMIR: 330 KB en vez de
  # 108. En una conexión móvil eso es más de un segundo perdido, y no se ve
  # desde un portátil con fibra.
  AddOutputFilterByType DEFLATE text/javascript application/javascript
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/x-javascript application/xhtml+xml
</IfModule>

# LiteSpeed, que es lo que corre en este hosting, entiende además Brotli, que
# comprime otro 15 % sobre gzip. Se activa por su cuenta si está disponible;
# esto solo declara qué tipos merece la pena comprimir.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain
  AddOutputFilterByType BROTLI_COMPRESS application/json image/svg+xml
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# 5. Cabeceras de seguridad
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # El navegador respeta el tipo declarado y no adivina por el contenido
  Header set X-Content-Type-Options "nosniff"
  # Nadie puede meter el sitio dentro de un iframe suyo
  Header set X-Frame-Options "SAMEORIGIN"
  # Al salir a otro dominio se manda el origen, no la URL completa
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # Sin uso de cámara, micrófono ni ubicación
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
# Falta deliberadamente una Content-Security-Policy: mal escrita rompe el sitio
# en silencio, y escribirla bien exige inventariar antes todo lo que carga la
# página. Es el siguiente paso, no este.

# El listado de carpetas queda desactivado
Options -Indexes
