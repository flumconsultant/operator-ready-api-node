node_modules/
.DS_Store
dist/

# Guiones de verificación de una sola sesión (Playwright, medición de páginas)
_*.mjs

# El .zip del contenido se genera con scripts/exportar-contenido.mjs; los .md sí
# se versionan, para poder ver qué cambió entre una revisión de texto y otra.
contenido/*.zip
contenido/revision/*.zip

# BECOME Pulse: el .env con las claves nunca se sube, y el build de Next
# tampoco. `dist/` y `node_modules/` ya están cubiertos arriba.
pulse/.env
pulse/**/.env
pulse/web/.next/
