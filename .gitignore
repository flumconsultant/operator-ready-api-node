node_modules/
.DS_Store
dist/

# Guiones de verificación de una sola sesión (Playwright, medición de páginas)
_*.mjs

# El .zip del contenido se genera con scripts/exportar-contenido.mjs; los .md sí
# se versionan, para poder ver qué cambió entre una revisión de texto y otra.
contenido/*.zip
contenido/revision/*.zip

# Las capturas del recorrido del panel: se regeneran al ejecutarlo.
capturas-panel/

# Copias de seguridad de los flujos de n8n: scripts/n8n.mjs guarda la versión
# anterior antes de cada actualización o borrado. Son volcados de la instancia,
# no fuente; se regeneran solas y ensucian el historial.
automatizacion/n8n/copias/
