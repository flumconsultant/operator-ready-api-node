{
  "nombre": "linkedin",
  "sistema": "LinkedIn · página de empresa",
  "queHace": "Anuncia en la página de empresa el artículo recién publicado.",
  "implementacion": "scripts/linkedin.mjs",
  "disparadores": [
    "tras-despliegue",
    "a-mano"
  ],
  "credenciales": [
    {
      "clave": "LINKEDIN_TOKEN",
      "caduca": "60d",
      "avisar": "14d",
      "renueva": "docs/linkedin.md"
    },
    {
      "clave": "LINKEDIN_ORG_ID",
      "caduca": "nunca",
      "renueva": "docs/linkedin.md"
    },
    {
      "clave": "LINKEDIN_CLIENT_ID",
      "caduca": "nunca",
      "renueva": "docs/linkedin.md"
    },
    {
      "clave": "LINKEDIN_CLIENT_SECRET",
      "caduca": "al-rotarla",
      "renueva": "docs/linkedin.md"
    }
  ],
  "acciones": [
    {
      "nombre": "publicar-articulo",
      "efecto": "irreversible",
      "ensayo": "node scripts/linkedin.mjs --ensayo"
    }
  ],
  "registro": ".github/linkedin-publicado.json",
  "centinela": "comprueba en LinkedIn que el post existe y está publicado",
  "notas": "El centinela pregunta a LinkedIn por el post recién creado. Si no está, el artículo vuelve a la cola: el registro no puede decir que se anunció algo que no existe."
}
