{
  "name": "@become/pulse-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "tokens": "node ../scripts/sincronizar-tokens.mjs",
    "db:generar": "prisma generate",
    "db:migrar": "prisma migrate dev",
    "db:desplegar": "prisma migrate deploy",
    "db:semilla": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "resumen": "tsx scripts/resumen.ts",
    "revisar:interfaz": "node scripts/revisar-interfaz.mjs",
    "empresa:crear": "tsx scripts/crear-empresa.ts",
    "test": "node --test --import tsx pruebas/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "next": "^15.5.23",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.62.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
