// Modelo de datos de BECOME Pulse.
// Las cinco entidades del PRD (Company, User, Value, Recognition, WeeklyInsight)
// más lo que Auth.js necesita para guardar sesiones y tokens de magic link.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  MANAGER
  COLABORADOR
}

enum Canal {
  WEB
  DISCORD
}

enum TipoNotificacion {
  RECONOCIMIENTO_RECIBIDO
  COMENTARIO
  REACCION
}

/// Lo que queda registrado en la auditoría. Son acciones de administración y
/// de acceso, no actividad del feed: quién reconoció a quién ya está en
/// `recognitions` con su fecha, y duplicarlo aquí solo daría dos versiones de
/// la misma verdad que algún día no coincidirían.
enum AccionAuditada {
  EMPRESA_ACTUALIZADA
  PERSONA_INVITADA
  PERSONA_EDITADA
  PERSONA_DESACTIVADA
  PERSONA_REACTIVADA
  INVITACION_RENOVADA
  INVITACION_ACEPTADA
  VALOR_CREADO
  VALOR_RETIRADO
  VALOR_REACTIVADO
}

/// Un workspace: una empresa cliente. Todo lo demás cuelga de aquí.
model Company {
  id                 String   @id @default(cuid())
  nombre             String
  slug               String   @unique
  plan               String   @default("piloto")
  /// Nombre del archivo en el almacén de imágenes. Sustituye al wordmark de
  /// Pulse en la barra lateral y en la pantalla de acceso: quien entra tiene
  /// que ver su empresa, no la nuestra.
  logo               String?
  /// Dominio de correo de la empresa. Si está puesto, al invitar se avisa
  /// cuando una dirección no lo cumple — no se bloquea, porque los becarios y
  /// los externos existen.
  dominioCorreo      String?
  /// Servidor de Discord conectado, si lo hay.
  discordGuildId     String?  @unique
  /// Canal donde el bot publica el espejo del feed.
  discordCanalFeedId String?
  /// Tope de reconocimientos que se procesan con IA al mes. El PRD pide
  /// vigilar el coste de la API desde el primer día; esto es ese freno.
  limiteIaMensual    Int      @default(2000)
  creadaEn           DateTime @default(now())

  usuarios        User[]
  valores         Value[]
  auditoria       AuditLog[]
  reconocimientos Recognition[]
  insights        WeeklyInsight[]

  @@map("companies")
}

/// Un valor de la empresa. Son las opciones que salen al reconocer, y los
/// configura el admin: por eso pertenecen a la Company y no son un enum.
model Value {
  id          String  @id @default(cuid())
  companyId   String
  nombre      String
  descripcion String?
  /// Emoji con el que sale en Discord y en el feed.
  emoji       String  @default("✨")
  orden       Int     @default(0)
  activo      Boolean @default(true)

  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reconocimientos Recognition[]

  @@unique([companyId, nombre])
  @@index([companyId, activo])
  @@map("values")
}

model User {
  id               String    @id @default(cuid())
  companyId        String
  nombre           String
  email            String    @unique
  /// Hash bcrypt. Nulo si la persona solo entra por magic link.
  passwordHash     String?
  emailVerified    DateTime?
  /// Nombre del archivo en el almacén de imágenes, no una URL completa: el
  /// dominio cambia entre local, piloto y producción, y una URL guardada se
  /// queda apuntando al anterior.
  imagen           String?
  rol              Rol       @default(COLABORADOR)
  equipo           String?
  cargo            String?
  bio              String?
  /// Día y mes son lo único que se usa; el año se guarda porque una fecha
  /// parcial complica más de lo que protege, y no se muestra nunca.
  cumpleanos       DateTime?
  fechaIngreso     DateTime?
  discordId        String?   @unique
  activo           Boolean   @default(true)
  invitadoEn       DateTime  @default(now())
  /// Invitación pendiente. Es un mecanismo propio y no el magic link de
  /// Auth.js: el enlace se puede copiar y mandar por WhatsApp, que es lo que
  /// va a pasar en un piloto sin servidor de correo montado.
  tokenInvitacion  String?   @unique
  invitacionExpira DateTime?
  /// Cuándo entró por primera vez. Sirve para saber a quién hay que perseguir.
  primerAcceso     DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dados          Recognition[]  @relation("reconocimientosDados")
  recibidos      Recognition[]  @relation("reconocimientosRecibidos")
  reacciones     Reaction[]
  comentarios    Comment[]
  notificaciones Notification[] @relation("destinatario")
  provocadas     Notification[] @relation("actor")
  auditoria      AuditLog[]     @relation("auditor")
  accounts       Account[]
  sessions       Session[]

  @@index([companyId])
  @@map("users")
}

/// El reconocimiento en sí. `sentimiento*` lo rellena la capa de IA de forma
/// asíncrona: un reconocimiento se guarda y se ve en el feed aunque la API de
/// Claude esté caída o el cupo del mes esté agotado.
model Recognition {
  id         String   @id @default(cuid())
  companyId  String
  deUserId   String
  paraUserId String
  valueId    String
  mensaje    String
  /// Una foto por reconocimiento, como en cualquier feed. Es el nombre del
  /// archivo, no una URL, por el mismo motivo que en User.imagen.
  imagen     String?
  canal      Canal    @default(WEB)
  creadoEn   DateTime @default(now())

  /// -1 (frío) a 1 (cálido). Nulo mientras no se ha analizado.
  sentimientoScore Float?
  /// Cuánto se apoya en hechos concretos frente a una fórmula genérica, 0-1.
  especificidad    Float?
  sentimientoTono  String?
  analizadoEn      DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  de             User           @relation("reconocimientosDados", fields: [deUserId], references: [id], onDelete: Cascade)
  para           User           @relation("reconocimientosRecibidos", fields: [paraUserId], references: [id], onDelete: Cascade)
  valor          Value          @relation(fields: [valueId], references: [id])
  reacciones     Reaction[]
  comentarios    Comment[]
  notificaciones Notification[]

  @@index([companyId, creadoEn])
  @@index([paraUserId, creadoEn])
  @@index([deUserId, creadoEn])
  @@index([companyId, analizadoEn])
  @@map("recognitions")
}

/// La reacción del feed. Una por persona y reconocimiento, cambiable: quien
/// ya aplaudió y pulsa el corazón cambia de reacción en vez de acumular dos.
/// Es el comportamiento de LinkedIn, no el de Slack, y para un feed corto de
/// empresa se lee mejor: cinco filas de emoji debajo de cada post convierten
/// el reconocimiento en un concurso de reacciones.
model Reaction {
  id            String   @id @default(cuid())
  recognitionId String
  userId        String
  emoji         String   @default("👏")
  creadaEn      DateTime @default(now())

  reconocimiento Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recognitionId, userId])
  @@map("reactions")
}

/// Un comentario en un reconocimiento. Sin hilos anidados a propósito: en un
/// feed de empresa de cincuenta personas, las respuestas a respuestas no
/// aportan y sí complican la lectura y el moderado.
model Comment {
  id            String    @id @default(cuid())
  recognitionId String
  userId        String
  texto         String
  creadoEn      DateTime  @default(now())
  editadoEn     DateTime?

  reconocimiento Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recognitionId, creadoEn])
  @@map("comments")
}

/// Notificaciones en la aplicación. Las de Discord las manda el bot y no pasan
/// por aquí: esta tabla es lo que se ve al pulsar la campana.
model Notification {
  id            String           @id @default(cuid())
  userId        String
  actorId       String?
  recognitionId String?
  tipo          TipoNotificacion
  texto         String
  enlace        String
  leidaEn       DateTime?
  creadaEn      DateTime         @default(now())

  user           User         @relation("destinatario", fields: [userId], references: [id], onDelete: Cascade)
  actor          User?        @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  reconocimiento Recognition? @relation(fields: [recognitionId], references: [id], onDelete: Cascade)

  @@index([userId, leidaEn, creadaEn])
  @@map("notifications")
}

/// El resumen semanal que genera la IA para RRHH.
model WeeklyInsight {
  id         String   @id @default(cuid())
  companyId  String
  semanaIso  String
  /// Los 3-5 insights en texto, ya redactados.
  contenido  String
  /// Las cifras con las que se redactó, para poder auditar el resumen.
  datos      Json
  generadoEn DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, semanaIso])
  @@map("weekly_insights")
}

/// El registro de auditoría.
///
/// Existe porque las acciones que hay aquí cambian quién puede entrar y con qué
/// permisos, y esas son las únicas que alguien va a querer reconstruir seis
/// meses después: quién ascendió a quién a administrador, quién desactivó a
/// alguien y cuándo, quién cambió el tope de gasto de la IA.
///
/// No se borra ni se edita desde ninguna parte de la aplicación. Un registro
/// que la propia interfaz puede modificar no sirve para auditar nada.
model AuditLog {
  id             String         @id @default(cuid())
  companyId      String
  /// Nulo cuando la acción no la hace una persona identificada: aceptar una
  /// invitación ocurre antes de tener sesión.
  actorId        String?
  /// El nombre se copia en el momento, además de la referencia. Si esa persona
  /// se va y se desactiva, el registro tiene que seguir diciendo quién fue.
  actorNombre    String?
  accion         AccionAuditada
  /// A quién o a qué afectó, también con su nombre congelado.
  objetivoId     String?
  objetivoNombre String?
  /// Lo que cambió, en pares campo/antes/después. Es lo que convierte «persona
  /// editada» en algo que se puede leer.
  cambios        Json?
  creadoEn       DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actor   User?   @relation("auditor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([companyId, creadoEn])
  @@index([companyId, accion, creadoEn])
  @@map("audit_logs")
}

// ---- Tablas de Auth.js ----------------------------------------------------
// La sesión va en JWT, pero el magic link necesita guardar el token en la base
// y el adaptador exige estas tablas.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
