# Copia este archivo a `.env` y rellénalo. `.env` NUNCA se sube al repositorio:
# está en el .gitignore y ahí se queda.
#
#   cp pulse/.env.example pulse/.env
#
# En el VPS, estas mismas variables se cargan desde el `.env` que vive junto al
# docker-compose.yml, o desde las variables protegidas del CI/CD.

# ---- Base de datos --------------------------------------------------------
POSTGRES_USER=pulse
POSTGRES_PASSWORD=cambia-esto-por-algo-largo
POSTGRES_DB=pulse
# Dentro de Docker el host es `db`, que es el nombre del servicio.
DATABASE_URL=postgresql://pulse:cambia-esto-por-algo-largo@db:5432/pulse?schema=public

# ---- Aplicación -----------------------------------------------------------
# Genera el secreto con: openssl rand -base64 48
AUTH_SECRET=
# En producción las dos son https://pulse.meetbecome.com
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# ---- Claves compartidas ---------------------------------------------------
# El bot y la web se autentican entre sí con esta. openssl rand -hex 32
INTERNAL_API_TOKEN=
# Protege el endpoint del resumen semanal. openssl rand -hex 32
CRON_TOKEN=

# ---- Capa de IA -----------------------------------------------------------
# Sin esto Pulse funciona: el feed, los paneles y el bot van igual. Lo que se
# apaga es el análisis de sentimiento y la redacción del resumen semanal.
# La clave es de servidor y nunca llega al navegador.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-opus-5

# ---- Imágenes -------------------------------------------------------------
# Dónde se guardan las fotos de perfil y las de las publicaciones. Dentro de
# Docker es un volumen; en local, cualquier carpeta con permisos de escritura.
ALMACEN_IMAGENES=/app/subidas

# ---- Discord --------------------------------------------------------------
# De https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ---- Correo (magic link) --------------------------------------------------
# Si lo dejas vacío, el enlace de acceso se escribe en el log del contenedor
# `web` en vez de enviarse. Sirve para el piloto; para producción, ponlo.
SMTP_URL=
SMTP_DESDE=BECOME Pulse <pulse@meetbecome.com>

# ---- Reverse proxy --------------------------------------------------------
# El dominio que apunta al VPS. Caddy saca el certificado solo.
# En producción: pulse.meetbecome.com
# Para desarrollo local, déjalo en `localhost`.
DOMINIO=localhost
