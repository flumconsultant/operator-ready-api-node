      "parameters": {
        "jsCode": "/* Cuatro servicios inventados con la misma forma que tendrá la hoja real:\n   una fila por servicio, con nombre, duración y precio. Sirven para recorrer\n   el flujo entero sin tocar Google Sheets. Cuando exista el catálogo 2026 de\n   verdad, esta rama se queda igual: solo se usa en modo prueba. */\n\nreturn [\n  { servicio: 'Limpieza facial profunda',   duracion: '60 min', precio: 'S/ 120' },\n  { servicio: 'Depilación láser axilas',    duracion: '20 min', precio: 'S/ 90'  },\n  { servicio: 'Masaje descontracturante',   duracion: '50 min', precio: 'S/ 110' },\n  { servicio: 'Peeling químico',            duracion: '45 min', precio: 'S/ 180' },\n].map((fila) => ({ json: fila, pairedItem: { item: 0 } }));"
      }
    },
    {
      "id": "p04-sheets",
      "name": "P04a · Leer catálogo 2026",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1472,
