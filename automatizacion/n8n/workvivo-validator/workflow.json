    {
      "id": "6d275901-8630-5b73-bde7-36d9a703118e",
      "name": "Crear solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// CREAR SOLICITUD: request_id único + datos de correlación (nunca se envían al modelo).\nconst b = $('Mensaje de Workvivo').first().json.body;\nconst hex = () => Math.floor(Math.random() * 0x1000000).toString(16).padStart(6, '0');\nconst request_id = 'req_' + hex() + hex() + hex() + hex();\nconst now = new Date();\nconst TTL_MINUTOS = 10; // Propuesta: la latencia observada de Validator fue 30–130 s.\nreturn [{ json: {\n  request_id,\n  conversation_key: 'workvivo:v2:' + b.bot.bot_userid + ':' + b.channel.channel_url,\n  channel_url: b.channel.channel_url,\n  bot_userid: b.bot.bot_userid,\n  event_id: String(b.message.message_id),\n  workvivo_user_id: String(b.sender.user_id),\n  text: String(b.message.text),\n  user_sent_at: new Date(Number(b.message.created_at || b.ts || now.getTime())).toISOString(),\n  received_at: now.toISOString(),\n  expires_at: new Date(now.getTime() + TTL_MINUTOS * 60000).toISOString(),\n} }];\n"
      }
    },
