      "parameters": {
        "jsCode": "// Marca de tiempo del acuse \"Estoy revisando tu consulta…\".\nconst r = $input.first().json || {};\nreturn [{ json: { ack_at: new Date().toISOString(), ack_http_status: Number(r.statusCode || 0) } }];\n"
      }
