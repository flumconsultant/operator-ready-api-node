      "id": "5e39492a-865a-5a81-80dc-3c372064238c",
      "name": "¿Es mensaje de un usuario?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.chatgpt.com/v1/workspace_agents/agtch_6ab45ece754c8191808065bce0dabc9a/trigger",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "value": "={{ $json.body.message.message_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_key: $json.body.channel.channel_url, input: 'MENSAJE DEL USUARIO:\\n' + $json.body.message.text + '\\n\\nDATOS PARA RESPONDER:\\nchannel_url: ' + $json.body.channel.channel_url + '\\nbot_userid: ' + $json.body.bot.bot_userid }) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "0b55066e-c920-50d9-87da-b761b63a7520",
      "name": "Enviar a Validator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "id": "c6ce9cbe-e466-58ff-bbba-297d35961038",
      "name": "Extraer respuesta de Validator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "jsCode": "// EXTRAER RESPUESTA DE VALIDATOR\n// Solo se publica el texto final. Nunca razonamiento, trazas ni datos técnicos.\nconst wh = $('Mensaje de Workvivo').first().json.body;\nconst r = $input.first().json || {};\nconst status = Number(r.statusCode || 0);\nlet body = r.body;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) {} }\n\n// Texto final según el formato documentado de la API Responses de OpenAI:\n// output[] -> elementos type \"message\" -> content[] con type \"output_text\".\n// El endpoint actual del canal API (workspace_agents/.../trigger) NO devuelve texto (solo conversation_url).\nlet text = '';\nif (body && Array.isArray(body.output)) {\n  text = body.output\n    .filter((o) => o && o.type === 'message')\n    .flatMap((o) => o.content || [])\n    .filter((c) => c && c.type === 'output_text' && typeof c.text === 'string')\n    .map((c) => c.text)\n    .join('\\n')\n    .trim();\n}\n\nconst ok = !r.error && status >= 200 && status < 300 && text.length > 0;\nconst bodyRecibido = r.error ? String(r.error.message || r.error) : (typeof body === 'string' ? body : JSON.stringify(body ?? ''));\nreturn [{ json: {\n  ok,\n  text,\n  channel_url: wh.channel.channel_url,\n  bot_userid: wh.bot.bot_userid,\n  message_id: String(wh.message.message_id),\n  httpStatus: status,\n  error: ok ? '' : (r.error ? 'ERROR_DE_RED_O_TIMEOUT' : (status < 200 || status >= 300) ? 'HTTP_' + status : 'RESPUESTA_SIN_TEXTO'),\n  bodyRecibido: ok ? '' : bodyRecibido.slice(0, 2000),\n} }];\n"
      }
    },
    {
      "id": "d1e9bd53-def3-5333-a03f-b6af08c45ac9",
      "name": "¿Respuesta válida?",
      "type": "n8n-nodes-base.if",
