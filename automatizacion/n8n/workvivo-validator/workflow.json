      "id": "77cfecc9-4ac8-5d8b-a33a-474cf20cc39c",
      "name": "Trigger aceptado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -100
      ],
      "parameters": {
        "jsCode": "// El canal API aceptó la ejecución (no devuelve texto; solo conversation_url).\nconst s = $('Crear solicitud').first().json;\nconst ack = $('Hora ACK').first().json;\nconst now = new Date();\nreturn [{ json: {\n  request_id: s.request_id, status: 'triggered', error_code: '', http_status: 202,\n  ack_at: ack.ack_at, trigger_at: now.toISOString(),\n  t_ack_ms: new Date(ack.ack_at) - new Date(s.user_sent_at),\n  t_trigger_ms: now - new Date(s.received_at),\n} }];\n"
      }
    },
    {
      "id": "af550584-7046-5af3-add8-1c90c7531ac3",
      "name": "Trigger fallido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "jsCode": "// El canal API rechazó la ejecución tras los reintentos (401/403/404/409/5xx...).\nconst s = $('Crear solicitud').first().json;\nconst ack = $('Hora ACK').first().json;\nconst e = $input.first().json || {};\nconst msg = String((e.error && (e.error.message || e.error)) || e.message || '');\nconst m = msg.match(/\\b([1-5]\\d\\d)\\b/);\nconst now = new Date();\nreturn [{ json: {\n  request_id: s.request_id, status: 'failed', error_code: 'TRIGGER_' + (m ? m[1] : 'ERROR'), http_status: m ? Number(m[1]) : 0,\n  ack_at: ack.ack_at, trigger_at: now.toISOString(),\n  t_ack_ms: new Date(ack.ack_at) - new Date(s.user_sent_at),\n  t_trigger_ms: now - new Date(s.received_at),\n} }];\n"
      }
    },
