    {
      "id": "5882f82a-2f64-5018-87f3-e3dbb9a5b5fb",
      "name": "Evaluar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        780
      ],
      "parameters": {
        "jsCode": "// EVALUAR SOLICITUD: el request_id debe existir (creado por el backend), no estar enviado ni vencido.\nconst v = $('Validar parámetros').first().json;\nconst row = $input.first().json || {};\nconst now = new Date();\nlet action = 'send', status = '';\nif (!row.id || row.request_id !== v.request_id) { action = 'reject'; status = 'not_found'; }\nelse if (row.status === 'completed' || row.status === 'sending') { action = 'reject'; status = 'already_sent'; }\nelse if (row.status === 'timeout' || row.status === 'failed') { action = 'reject'; status = row.status; }\nelse if (row.expires_at && new Date(row.expires_at) < now) { action = 'expire'; status = 'timeout'; }\nreturn [{ json: {\n  action, status, request_id: v.request_id, message: v.message,\n  channel_url: row.channel_url || '', bot_userid: row.bot_userid || '',\n  mcp_at: now.toISOString(), trigger_at: row.trigger_at || null, user_sent_at: row.user_sent_at || null, received_at: row.received_at || null,\n} }];\n"
      }
    },
