    {
      "id": "15a3e39e-3cb9-523f-8901-56b8ad9e2e85",
      "name": "Validar parámetros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        860
      ],
      "parameters": {
        "jsCode": "// VALIDAR PARÁMETROS DE send_workvivo_reply\nconst i = $input.first().json || {};\nconst request_id = String(i.request_id ?? '').trim();\nconst message = String(i.message ?? '').trim();\nlet error = '';\nif (!/^req_[0-9a-f]{24}$/.test(request_id)) error = 'invalid_request_id';\nelse if (!message) error = 'empty_message';\nelse if (message.length > 20000) error = 'message_too_long';\nreturn [{ json: { valid: !error, error, request_id, message } }];\n"
      }
    },
