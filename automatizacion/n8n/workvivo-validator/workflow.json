    {
      "id": "93e16ab6-a514-56fa-af31-d35f62cb0686",
      "name": "Cerrar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2060,
        680
      ],
      "parameters": {
        "jsCode": "// CERRAR SOLICITUD: resultado del envío a Workvivo + métricas de latencia.\nconst ev = $('Evaluar solicitud').first().json;\nconst r = $input.first().json || {};\nconst code = Number(r.statusCode || 0);\nconst ok = !r.error && code >= 200 && code < 300;\nconst now = new Date();\nconst ms = (a, b) => (a && b ? new Date(b) - new Date(a) : null);\nreturn [{ json: {\n  request_id: ev.request_id,\n  // Si falla la publicación, vuelve a \"triggered\" para permitir un reintento del agente.\n  status: ok ? 'completed' : 'triggered',\n  error_code: ok ? '' : 'WORKVIVO_' + (code || 'ERROR'),\n  http_status: code,\n  mcp_at: ev.mcp_at,\n  sent_at: ok ? now.toISOString() : null,\n  t_agent_ms: ms(ev.trigger_at, ev.mcp_at),\n  t_delivery_ms: ok ? ms(ev.mcp_at, now) : null,\n  t_total_ms: ok ? ms(ev.user_sent_at || ev.received_at, now) : null,\n} }];\n"
      }
    },
