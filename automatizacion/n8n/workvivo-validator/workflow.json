      "parameters": {
        "jsCode": "// RESPUESTA DUPLICADA: ya se publicó el mismo texto en este canal en los últimos 10 minutos.\nreturn [{ json: {\n  resultado: 'OK',\n  status: 200,\n  detalle: 'Esta respuesta ya había sido publicada en Workvivo; no se volvió a publicar (duplicado).',\n  instruccion: 'No vuelvas a llamar a esta herramienta para este mensaje.',\n} }];\n"
      }
    },
