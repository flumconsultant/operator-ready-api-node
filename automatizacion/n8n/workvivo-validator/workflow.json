    {
      "id": "ac2d37c8-d2ba-543a-8929-daa4041406c3",
      "name": "Publicar en Workvivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1840,
        680
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.workvivo.us/v1/chat/bots/message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
