    {
      "id": "807bed6c-d70f-51b7-9866-ec6e5ff02409",
      "name": "Validar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        760
      ],
      "parameters": {
        "jsCode": "// VALIDAR SOLICITUD DE VALIDATOR (herramienta responder_en_workvivo)\nconst i = $input.first().json || {};\nconst channel_url = String(i.channel_url ?? '').trim();\nconst bot_userid = String(i.bot_userid ?? '').trim();\nconst message = String(i.message ?? '').trim();\n\nconst faltan = [!channel_url && 'channel_url', !bot_userid && 'bot_userid', !message && 'message'].filter(Boolean);\nlet error = faltan.length ? 'Faltan parámetros obligatorios: ' + faltan.join(', ') : '';\n// Solo bots de esta organización de Workvivo (1000242).\nif (!error && !bot_userid.startsWith('wv_1000242_')) error = 'bot_userid no pertenece a esta organización de Workvivo';\n\n// Idempotencia: el formato del mensaje a Validator no incluye el id del evento original,\n// así que la clave es channel_url + huella (FNV-1a) del texto. Evita publicar dos veces la misma respuesta.\nconst fnv = (s, seed) => { let h = seed >>> 0; for (let k = 0; k < s.length; k++) { h ^= s.charCodeAt(k); h = Math.imul(h, 16777619) >>> 0; } return h.toString(16).padStart(8, '0'); };\nconst base = channel_url + '\\n' + message;\nconst dedupeKey = 'reply:' + channel_url + ':' + fnv(base, 2166136261) + fnv(base, 0x811c9dc5 ^ 0x5bd1e995);\n\nreturn [{ json: { valid: !error, error, channel_url, bot_userid, message, dedupeKey } }];\n"
      }
    },
