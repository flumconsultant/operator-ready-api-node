{
  "name": "Middleware Workvivo - Chatgpt",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "workvivo/validator",
        "options": {}
      },
      "id": "3b5a822c-9ba2-55a1-ba14-db84240579ab",
      "name": "Mensaje de Workvivo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "3f6b2d9e-8a41-4c7e-9b15-5d0e7a1c9f42"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "96f8e6af-7531-43fd-a69f-57e68c138c53",
              "leftValue": "={{ $json.body.category }}",
              "rightValue": "bot_message_notification",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "65c49657-4e94-4bee-9ffa-ac11d1adc0ed",
              "leftValue": "={{ $json.body.app_id }}",
              "rightValue": "FD0AEB65-5E89-415B-A51B-6D76E1998671",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "eb4120da-0d92-42d8-be24-48b75d37209c",
              "leftValue": "={{ $json.body.sender.user_id }}",
              "rightValue": "={{ $json.body.bot.bot_userid }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "c5a42649-4cba-4959-b0d0-f010c687ebde",
              "leftValue": "={{ $json.body.message.text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5e39492a-865a-5a81-80dc-3c372064238c",
      "name": "¿Es mensaje de un usuario?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.chatgpt.com/v1/workspace_agents/agtch_6ab45ece754c8191808065bce0dabc9a/trigger",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "value": "={{ $json.body.message.message_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_key: $json.body.channel.channel_url, input: $json.body.message.text + '\\n\\n---\\nCuando tengas tu respuesta final, usa la herramienta responder_en_workvivo con channel_url=' + $json.body.channel.channel_url + ' y bot_userid=' + $json.body.bot.bot_userid }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "0b55066e-c920-50d9-87da-b761b63a7520",
      "name": "Enviar a Validator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        512,
        -16
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "notesInFlow": true,
      "credentials": {
        "httpBearerAuth": {
          "id": "9ysXWLiFAeZZAHhJ",
          "name": "Bearer Auth account"
        }
      },
      "notes": "Reemplaza agtch_PEGAR_AQUI por el ID del canal API del agente (Agent Builder → API channel)."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.workvivo.io/v1/chat/bots/message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Workvivo-Id",
              "value": "1000242"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ bot_userid: $fromAI('bot_userid', 'Valor bot_userid indicado al final del mensaje recibido', 'string'), channel_url: $fromAI('channel_url', 'Valor channel_url indicado al final del mensaje recibido', 'string'), type: 'message', message: $fromAI('message', 'Respuesta final para el usuario, sin razonamiento interno', 'string') }) }}",
        "options": {
          "timeout": 15000
        },
        "toolDescription": "Publica la respuesta final de Validator en el chat de Workvivo del usuario. Llamar una sola vez por mensaje, al terminar la revisión."
      },
      "id": "16c43636-ce14-531f-b4c9-5057a3bfc1ee",
      "name": "responder_en_workvivo",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        240,
        520
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "9ysXWLiFAeZZAHhJ",
          "name": "Bearer Auth account"
        }
      }
    },
    {
      "parameters": {
        "content": "## Workvivo ↔ Validator (simple)\n**Ida:** Workvivo → *Mensaje de Workvivo* → filtro → *Enviar a Validator* (canal API, responde 202).\n**Vuelta:** el canal API no devuelve la respuesta. Validator usa la herramienta **responder_en_workvivo** del servidor **MCP para Validator** (añadido como MCP personalizado en Agent Builder), que publica en Workvivo.",
        "height": 300,
        "width": 760,
        "color": 4
      },
      "id": "9de00772-ea9b-580f-a6cd-1b5466de071a",
