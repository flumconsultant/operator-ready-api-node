      ],
      "parameters": {
        "jsCode": "// SOLICITUDES VENCIDAS: \"triggered\" cuyo expires_at ya pasó -> timeout.\nconst now = new Date();\nreturn $input.all()\n  .map((i) => i.json)\n  .filter((r) => r && r.request_id && r.status === 'triggered' && r.expires_at && new Date(r.expires_at) < now)\n  .map((r) => ({ json: { request_id: r.request_id, status: 'timeout', error_code: 'TIMEOUT' } }));\n"
      }
    },
