        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ bot_userid: $('Evaluar solicitud').first().json.bot_userid, channel_url: $('Evaluar solicitud').first().json.channel_url, type: 'message', message: $('Evaluar solicitud').first().json.message }) }}",
        "options": {
