    {
      "id": "1883565a-c1aa-59bb-9f76-79d6589c328b",
      "name": "Publicar en Workvivo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.workvivo.us/v1/chat/bots/message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Workvivo-Id",
              "value": "1000242"
            }
          ]
        },
