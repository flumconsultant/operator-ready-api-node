    {
      "id": "536c11b6-445e-5eda-806d-c8d732b7c0ca",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2500,
        860
      ],
      "parameters": {
        "jsCode": "// RESPUESTA MÍNIMA PARA EL AGENTE\nlet out;\ntry {\n  const c = $('Cerrar solicitud').first().json;\n  out = c.status === 'completed'\n    ? { success: true, request_id: c.request_id, status: 'sent' }\n    : { success: false, request_id: c.request_id, status: 'error', http_status: c.http_status };\n} catch (e) {\n  const v = $('Validar parámetros').first().json;\n  let ev = null; try { ev = $('Evaluar solicitud').first().json; } catch (e2) {}\n  if (!v.valid) out = { success: false, request_id: v.request_id, status: v.error };\n  else if (ev && ev.status === 'already_sent') out = { success: true, request_id: ev.request_id, status: 'already_sent' };\n  else out = { success: false, request_id: v.request_id, status: ev ? ev.status : 'error' };\n}\nreturn [{ json: out }];\n"
      }
    },
