    {
      "parameters": {
        "jsCode": "/* Ponlo en false cuando el backend entregue el TRAMA Index real: el flujo\n   volverá a mandar al error de validación cualquier diagnóstico sin índice. */\nconst CALCULO_PROVISIONAL = true;\n\nconst j = $input.first().json || {};\nconst cfg = $('Preparar configuración').first().json;\n\n/* Lo que venga del backend (o de los datos de prueba) manda siempre. */\nlet indice = typeof j.trama_index === \"number\" ? j.trama_index\n  : (typeof j.score === \"number\" ? j.score : null);\nif (indice !== null && !Number.isFinite(indice)) indice = null;\n\nlet provisional = false;\nconst puntuadas = {};\n\nif (indice === null && CALCULO_PROVISIONAL) {\n  /* Las respuestas llegan como etiquetas —«Casi siempre»—, no como números.\n     Cada pregunta trae de la hoja su tabla de etiqueta a valor, y cada escala\n     su propio mínimo y máximo. Se normaliza pregunta a pregunta y se promedia,\n     así una escala de 1 a 5 y otra de 0 a 1 pesan igual y nadie tiene que\n     acordarse de reajustar nada al añadir una escala nueva. */\n  const normalizados = [];\n\n  for (const p of cfg.preguntas || []) {\n    const dado = j[p.id];\n    if (dado === undefined || dado === null || String(dado).trim() === \"\") continue;\n\n    let valor = p.valores ? p.valores[String(dado)] : undefined;\n    if (valor === undefined || valor === null) {\n      const n = Number(dado);\n      valor = Number.isFinite(n) ? n : undefined;\n    }\n    if (valor === undefined || valor === null) continue;\n\n    const escala = (p.opciones || []).map((o) => o.valor).filter((v) => Number.isFinite(v));\n    if (escala.length < 2) continue;\n    const min = Math.min.apply(null, escala);\n    const max = Math.max.apply(null, escala);\n    if (max === min) continue;\n\n    puntuadas[p.id] = valor;\n    normalizados.push((valor - min) / (max - min));\n  }\n\n  if (normalizados.length) {\n    indice = Math.round((normalizados.reduce((a, b) => a + b, 0) / normalizados.length) * 100);\n    provisional = true;\n  }\n}\n\nreturn [{\n  json: {\n    ...j,\n    trama_index: indice,\n    trama_index_provisional: provisional,\n    respuestas_puntuadas: puntuadas,\n    calculo_pendiente: indice === null,\n    nota_calculo: provisional\n      ? \"PROVISIONAL: media normalizada de las respuestas segun la escala de cada pregunta. No es la formula TRAMA. [pendiente: formula, dimensiones y ponderaciones reales]\"\n      : \"[pendiente: formula, dimensiones y ponderaciones del TRAMA Index]\",\n  },\n  pairedItem: { item: 0 },\n}];"
      },
