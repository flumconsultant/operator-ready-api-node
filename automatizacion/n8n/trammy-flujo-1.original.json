        "jsCode": "// [pendiente: fórmula o criterio exacto para calcular el porcentaje de coherencia (objetivo > 90%)]\n// Interpretación provisional y marcada como pendiente: se considera coherente solo si la\n// respuesta NO está malformada (tiene texto). El umbral real > 90% queda pendiente de fórmula.\nconst items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const j = it.json || {};\n  let texto = \"\";\n  if (Array.isArray(j.content) && j.content[0] && j.content[0].text) {\n    texto = j.content[0].text;\n  } else if (typeof j.text === \"string\") {\n    texto = j.text;\n  }\n  const malformado = texto === \"\";\n  const intento = $runIndex; // 0 = primer intento; 1 y 2 = reinterpretaciones automáticas\n  const es_coherente = !malformado; // [pendiente] hasta definir la fórmula real de coherencia\n  out.push({ json: {\n    recomendaciones: texto,\n    malformado: malformado,\n    intento: intento,\n    coherencia_pct: null,\n    es_coherente: es_coherente,\n    pendiente_coherencia: \"[pendiente: fórmula o criterio exacto para calcular el porcentaje de coherencia]\"\n  } });\n}\nreturn out;"
      },
