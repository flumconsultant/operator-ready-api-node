      "parameters": {
        "jsCode": "// [pendiente: fórmula exacta, dimensiones, ponderaciones y campos usados en el cálculo]\n// No se fabrican valores faltantes: si no hay una puntuación válida, queda pendiente.\nconst j = $input.first().json || {};\nlet raw = j.trama_index;\nif (raw === undefined) raw = j.score;\nconst trama_index = (typeof raw === \"number\" && !Number.isNaN(raw)) ? raw : null;\nconst calculo_pendiente = trama_index === null;\nreturn [{ json: Object.assign({}, j, {\n  trama_index: trama_index,\n  calculo_pendiente: calculo_pendiente,\n  nota_calculo: \"[pendiente: fórmula, dimensiones y ponderaciones del TRAMA Index]\"\n}) }];"
